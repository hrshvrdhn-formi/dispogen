# Credentials are resolved by the Anthropic SDK in this order:
#   ANTHROPIC_API_KEY -> ANTHROPIC_AUTH_TOKEN -> an `ant auth login` profile.
# A bare client works after `ant auth login` with no variable set at all.
ANTHROPIC_API_KEY=

# Salt for de-identification. Same salt => same synthetic identities across runs.
# Keep it out of version control; rotate it and the mapping changes.
DISPOGEN_DEID_SALT=
